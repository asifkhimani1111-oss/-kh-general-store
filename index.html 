
<!DOCTYPE html>
<html lang="gu">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#087443">
<title>K.H GENERAL STORE</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f5f6f2;font-family:Arial,sans-serif;color:#222}
header{background:#087443;color:white;padding:17px;text-align:center}
header h2{margin:0;font-size:23px}
header p{margin:6px 0 0;font-size:13px}
.store{margin:12px;background:white;border-radius:14px;overflow:hidden}
.store img{width:100%;height:175px;object-fit:cover;background:#ddd}
.store h3{padding:0 14px;margin:12px}
.search{padding:12px}
.search input{width:100%;padding:14px;border:1px solid #ccc;border-radius:10px;font-size:16px}
.categories{display:flex;gap:9px;overflow:auto;padding:4px 12px 14px}
.categories button{white-space:nowrap;border:0;background:white;padding:11px 15px;border-radius:20px}
.categories button.active{background:#087443;color:white}
h3.heading{padding:0 12px}
.products{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding:12px}
.product{background:white;border-radius:13px;overflow:hidden;padding-bottom:12px}
.product img{width:100%;height:135px;object-fit:cover;background:#eee}
.product h4{margin:9px 9px 5px;font-size:15px}
.product p{margin:5px 9px;color:#087443;font-weight:bold}
.controls{display:flex;align-items:center;justify-content:center;gap:13px;margin-top:9px}
.controls button{border:0;background:#087443;color:white;border-radius:7px;width:32px;height:32px;font-size:20px}
.cart{background:white;margin:12px;padding:15px;border-radius:13px}
.cart button,.checkout{background:#087443;color:white;border:0;padding:12px;border-radius:9px;width:100%;font-size:16px}
#cartItems{font-size:14px;line-height:1.8}
.notice{text-align:center;padding:12px;color:#666;font-size:12px}
</style>
</head>
<body>

<header>
<h2>🛒 K.H GENERAL STORE</h2>
<p>તમારા ઘરનો દરેક સામાન એક જ જગ્યાએ</p>
</header>

<section class="store">
<img id="storePhoto" alt="દુકાનનો ફોટો">
<h3>🏪 K.H GENERAL STORE</h3>
</section>

<div class="search">
<input id="search" placeholder="🔍 પ્રોડક્ટ શોધો..." oninput="renderProducts()">
</div>

<div class="categories" id="categories">
<button class="active" onclick="setCategory('બધી વસ્તુઓ',this)">બધી વસ્તુઓ</button>
<button onclick="setCategory('ફળો',this)">🍎 ફળો</button>
<button onclick="setCategory('શાકભાજી',this)">🥦 શાકભાજી</button>
<button onclick="setCategory('કરિયાણું',this)">🛍️ કરિયાણું</button>
<button onclick="setCategory('તેલ',this)">🛢️ તેલ</button>
<button onclick="setCategory('સાબુ',this)">🧼 સાબુ</button>
<button onclick="setCategory('અન્ય',this)">અન્ય</button>
</div>

<h3 class="heading">અમારી પ્રોડક્ટ્સ</h3>
<div class="products" id="products"></div>

<section class="cart">
<h3>🛒 તમારી ખરીદી</h3>
<div id="cartItems">હજુ કોઈ વસ્તુ ઉમેરાઈ નથી.</div>
<h3 id="total">કુલ: ₹0.00</h3>
<button onclick="checkout()">ઓર્ડર માટે આગળ વધો</button>
</section>

<div class="notice">
ઓર્ડર સમય: સવારે 9 થી સાંજે 6 વાગ્યા સુધી<br>
K.H GENERAL STORE
</div>

<script type="module">
import {db} from "./firebase.js";
import {
 collection,getDocs
} from "https://www.gstatic.com/firebasejs/12.19.0/firebase-firestore.js";

let products=[];
let cart={};
let category="બધી વસ્તુઓ";

window.setCategory=(value,button)=>{
 category=value;
 document.querySelectorAll(".categories button").forEach(b=>b.classList.remove("active"));
 button.classList.add("active");
 renderProducts();
};

function escapeHTML(value){
 return String(value??"").replace(/[&<>"']/g,c=>({
 "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
 })[c]);
}

function renderProducts(){
 const search=document.getElementById("search").value.toLowerCase();
 const filtered=products.filter(p=>
 (category==="બધી વસ્તુઓ"||p.category===category)&&
 String(p.name||"").toLowerCase().includes(search)
 );

 document.getElementById("products").innerHTML=filtered.map(p=>`
 <div class="product">
 <img src="${p.photo||""}" alt="${escapeHTML(p.name)}">
 <h4>${escapeHTML(p.name)}</h4>
 <p>₹${Number(p.price).toFixed(2)} / ${escapeHTML(p.unit||"નંગ")}</p>
 <div class="controls">
 <button onclick="changeQty('${p.id}',-1)">−</button>
 <b>${cart[p.id]?.qty||0}</b>
 <button onclick="changeQty('${p.id}',1)">+</button>
 </div>
 </div>`).join("")||"<p>પ્રોડક્ટ મળી નથી.</p>";
}

window.changeQty=(id,change)=>{
 const p=products.find(x=>x.id===id);
 if(!p)return;
 if(!cart[id])cart[id]={qty:0};
 cart[id].qty=Math.max(0,cart[id].qty+change);
 if(cart[id].qty===0)delete cart[id];
 renderProducts();
 renderCart();
};

function renderCart(){
 let total=0;
 let html="";
 Object.keys(cart).forEach(id=>{
 const p=products.find(x=>x.id===id);
 if(!p)return;
 const amount=Number(p.price)*cart[id].qty;
 total+=amount;
 html+=`${escapeHTML(p.name)} × ${cart[id].qty} = ₹${amount.toFixed(2)}<br>`;
 });
 document.getElementById("cartItems").innerHTML=html||"હજુ કોઈ વસ્તુ ઉમેરાઈ નથી.";
 document.getElementById("total").textContent="કુલ: ₹"+total.toFixed(2);
}

async function loadProducts(){
 try{
 const snap=await getDocs(collection(db,"products"));
 products=snap.docs.map(d=>({id:d.id,...d.data()}));
 renderProducts();
 }catch(e){
 document.getElementById("products").textContent="પ્રોડક્ટ લોડ થઈ શકી નથી. Admin Rules તપાસો.";
 }
}

window.checkout=()=>{
 const now=new Date();
 const minutes=now.getHours()*60+now.getMinutes();
 if(minutes<540||minutes>=1080){
 alert("ઓર્ડરનો સમય સવારે 9 થી સાંજે 6 વાગ્યા સુધી છે.");
 return;
 }
 if(!Object.keys(cart).length){
 alert("પહેલા પ્રોડક્ટ ઉમેરો.");
 return;
 }
 alert("કાર્ટ તૈયાર છે. ઓર્ડર સિસ્ટમ આગળના કોડમાં જોડાશે.");
};

loadProducts();
</script>
</body>
</html>
